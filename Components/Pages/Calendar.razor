@page "/calendar"
@using MudBlazor
@using JournalApplication.service
@using JournalApplicaton.Entities
@layout MainLayout
@inject NavigationManager Navigation
@inject IJournalService JournalService

<MudContainer MaxWidth="MaxWidth.Large" class="mb-6 pa-5 mt-5">
    <!-- Page Header -->
    <MudStack Spacing="3" Class="mb-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Calendar</MudText>
        <MudText Typo="Typo.body2" Style="color: black;">
            View your journal entries by date and navigate your history
        </MudText>
    </MudStack>

    <MudGrid Spacing="3">
        <!-- Calendar Section -->
        <MudItem xs="12" md="8">
            <MudCard Elevation="1">
                <MudCardContent>
                    <!-- Month Navigation -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Size="Size.Medium"
                                       OnClick="PreviousMonth" />

                        <MudText Typo="Typo.h6">
                            @_currentMonth.ToString("MMMM yyyy")
                        </MudText>

                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Size="Size.Medium"
                                       OnClick="NextMonth" />
                    </MudStack>

                    <!-- Day Headers -->
                    <MudGrid Spacing="1" Class="mb-2">
                        @foreach (var dayName in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                        {
                            <MudItem Style="width:14.28%; text-align:center;">
                                <MudText Typo="Typo.body2" Style="font-weight: 600; color: var(--mud-palette-text-secondary);">
                                    @dayName
                                </MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    <!-- Calendar Days -->
                    <MudGrid Spacing="1">
                        @foreach (var day in _calendarDays)
                        {
                            bool isFuture = day.Date.Date > DateTime.Today;
                            bool isToday = day.Date.Date == DateTime.Today;
                            
                            <MudItem Style="width:14.28%;">
                                <MudButton Variant="@GetDayVariant(day)"
                                           Color="@GetDayColor(day)"
                                           FullWidth="true"
                                           Size="Size.Small"
                                           Style="@GetDayStyle(day)"
                                           OnClick="@(() => SelectDate(day.Date))"
                                           Disabled="@(!day.IsCurrentMonth || isFuture)">
                                    <MudStack Spacing="0" AlignItems="AlignItems.Center" Style="@(isFuture ? "filter: blur(0.8px); opacity: 0.6;" : "")">
                                        <span style="@(isToday ? "font-weight: bold;" : "")">@day.Date.Day</span>
                                        @if (day.HasEntry)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Circle"
                                                     Size="Size.Small"
                                                     Color="@(isToday ? Color.Inherit : Color.Primary)"
                                                     Style="font-size: 8px !important; margin-top: 1px;" />
                                        }
                                        else 
                                        {
                                            <div style="height: 11px;"></div> @* Spacer to keep height consistent *@
                                        }
                                    </MudStack>
                                </MudButton>
                            </MudItem>
                        }
                    </MudGrid>

                    <!-- Legend -->
                    <MudDivider Class="my-4" />
                    <MudStack Row="true" Spacing="3" Justify="Justify.Center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Has Entry</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Default" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No Entry</MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Sidebar - Selected Date Info -->
        <MudItem xs="12" md="4">
            <!-- Today's Entry Card -->
            <MudCard Elevation="1" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Today's Entry</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_todayEntryExists && _todayJournal != null)
                    {
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2">
                                <strong>Status:</strong> ✓ Entry created
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <strong>Mood:</strong> @_todayJournal.PrimaryMood
                            </MudText>
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                @foreach (var tag in _todayJournal.Tags.Take(3))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                        @tag
                                    </MudChip>
                                }
                            </MudStack>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       FullWidth="true"
                                       OnClick="@(() => Navigation.NavigateTo($"/edit-journal/{_todayJournal.JournalId}"))">
                                Edit Entry
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.BookmarkBorder" Size="Size.Large" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                No entry for today
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       FullWidth="true"
                                       Href="/create-journal">
                                Create Entry
                            </MudButton>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Statistics Card -->
            <MudCard Elevation="1">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Statistics</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Entries this month:</MudText>
                            <MudText Typo="Typo.subtitle2">@_entriesThisMonth</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Current streak:</MudText>
                            <MudText Typo="Typo.subtitle2">@_currentStreak days</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Longest streak:</MudText>
                            <MudText Typo="Typo.subtitle2">@_longestStreak days</MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    // Calendar
    private DateTime _currentMonth = DateTime.Now;
    private DateTime _selectedDate = DateTime.Today;
    private List<CalendarDay> _calendarDays = new();
    
    // Cache of journals for the current month view
    private List<Journal> _monthJournals = new();

    // Today's Entry
    private bool _todayEntryExists = false;
    private Journal? _todayJournal;

    // Statistics
    private int _entriesThisMonth = 0;
    private int _currentStreak = 0; 
    private int _longestStreak = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMonthData();
        await CheckTodayEntry();
    }

    private async Task LoadMonthData()
    {
        var firstDay = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);
        
        try
        {
            var result = await JournalService.SearchJournalsAsync(0, "", "", "", firstDay, lastDay, 1, 100);
            _monthJournals = result.Item1;
            _entriesThisMonth = result.Item2;
            
            // Recalculate streaks for display
            var allResult = await JournalService.GetAllJournalsAsync(1, 10000);
            CalculateStreaks(allResult.Journals);
        }
        catch
        {
            // Ignore
        }

        GenerateCalendarDays();
    }

    private void CalculateStreaks(List<Journal> journals)
    {
        if (journals == null || !journals.Any()) return;
        
        var dates = journals.Select(j => j.CreateAT.Date).Distinct().OrderByDescending(d => d).ToList();
        
        // Current Streak
        int current = 0;
        DateTime checkDate = DateTime.Today;
        if (!dates.Contains(checkDate)) checkDate = checkDate.AddDays(-1);
        while (dates.Contains(checkDate)) { current++; checkDate = checkDate.AddDays(-1); }
        _currentStreak = current;

        // Longest Streak
        int longest = 0; int currentRun = 0;
        var ascendingDates = dates.OrderBy(d => d).ToList();
        for (int i = 0; i < ascendingDates.Count; i++) {
            if (i > 0 && ascendingDates[i] == ascendingDates[i - 1].AddDays(1)) currentRun++;
            else currentRun = 1;
            longest = Math.Max(longest, currentRun);
        }
        _longestStreak = longest;
    }
    
    private async Task CheckTodayEntry()
    {
        try
        {
            _todayJournal = await JournalService.GetJournalByDateAsync(DateTime.Today);
            _todayEntryExists = _todayJournal != null;
        }
        catch
        {
            _todayEntryExists = false;
        }
    }

    private void GenerateCalendarDays()
    {
        var firstDay = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);
        var startDate = firstDay.AddDays(-(int)firstDay.DayOfWeek);

        _calendarDays = new List<CalendarDay>();

        // Find calendar range (6 weeks to be safe)
        var endDate = lastDay.AddDays(6 - (int)lastDay.DayOfWeek);
        
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            var hasEntry = _monthJournals.Any(j => j.CreateAT.Date == date.Date);
            
            _calendarDays.Add(new CalendarDay
            {
                Date = date,
                IsCurrentMonth = date.Month == _currentMonth.Month,
                HasEntry = hasEntry
            });
        }
    }

    private async Task PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        await LoadMonthData();
    }

    private async Task NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        await LoadMonthData();
    }

    private async Task SelectDate(DateTime date)
    {
        if (date.Date > DateTime.Now.Date) return;
        _selectedDate = date;
        var journal = await JournalService.GetJournalByDateAsync(date);

        if (journal == null) Navigation.NavigateTo($"/create-journal?Date={date.Ticks}");
        else Navigation.NavigateTo($"/journal-detail/{journal.JournalId}");
    }

    private Variant GetDayVariant(CalendarDay day)
    {
        if (day.Date.Date == DateTime.Today) return Variant.Filled;
        if (day.HasEntry) return Variant.Outlined;
        return Variant.Text;
    }

    private Color GetDayColor(CalendarDay day)
    {
        if (day.Date.Date == DateTime.Today) return Color.Primary;
        if (day.HasEntry) return Color.Info;
        return Color.Default;
    }

    private string GetDayStyle(CalendarDay day)
    {
        if (day.Date.Date == DateTime.Today) return "border-radius: 8px;";
        if (day.HasEntry) return "border-radius: 8px; border: 1.5px solid var(--mud-palette-info);";
        return "";
    }

    private class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool HasEntry { get; set; }
    }
}
